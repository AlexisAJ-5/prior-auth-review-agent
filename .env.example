# Copy to .env and fill in. .env is git-ignored.

# --- LLM provider ------------------------------------------------------------------
# Gemini: free API key at https://aistudio.google.com/apikey (Flash-Lite has the most generous free quota)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=

# Gemini 3 works best at its default temperature; set LLM_TEMPERATURE=0 for other providers.
# LLM_TEMPERATURE=

# Ollama (local, free, no key): install Ollama, `ollama pull qwen3:8b`, then
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b
# From inside Docker, point at the host: LLM_BASE_URL=http://host.docker.internal:11434/v1

# OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5-mini
# LLM_API_KEY=sk-...

# Any other OpenAI-compatible server
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://.../v1

# If your provider rejects tool_choice="required", use auto.
# LLM_TOOL_CHOICE=auto

# --- Retrieval --------------------------------------------------------------------
# Local runs use in-memory Qdrant; Docker Compose overrides this with the Qdrant service.
# QDRANT_URL=:memory:
# "hashing" skips the embedding-model download (lexical retrieval only).
# EMBEDDING_BACKEND=fastembed
